{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "producer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "commit": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "version",
        "commit"
      ]
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "spec": {
            "type": "object",
            "properties": {
              "repository": {
                "type": "string",
                "minLength": 1
              },
              "tag": {
                "type": "string",
                "pattern": "^v\\d+\\.\\d+\\.\\d+$"
              },
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "capability": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+$"
              }
            },
            "required": [
              "repository",
              "tag",
              "commit",
              "capability",
              "revision"
            ]
          },
          "system": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+$"
              }
            },
            "required": [
              "id",
              "version"
            ]
          },
          "environment": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+$"
              }
            },
            "required": [
              "id",
              "version"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "id",
                "path",
                "sha256"
              ]
            }
          },
          "assessments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "evaluator": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "deterministic",
                    "mock-agent",
                    "human"
                  ]
                },
                "version": {
                  "type": "string",
                  "pattern": "^\\d+\\.\\d+\\.\\d+$"
                },
                "status": {
                  "enum": [
                    "PASS",
                    "FAIL",
                    "INSUFFICIENT_EVIDENCE"
                  ]
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                },
                "mandatory": {
                  "type": "boolean"
                },
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "provenance": {
                  "type": "object"
                }
              },
              "required": [
                "id",
                "evaluator",
                "kind",
                "version",
                "status",
                "rationale",
                "mandatory",
                "evidence_ids",
                "provenance"
              ]
            }
          },
          "provenance": {
            "type": "object"
          },
          "original_result": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "spec",
          "system",
          "environment",
          "evidence",
          "assessments",
          "provenance",
          "original_result"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "producer",
    "results"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
