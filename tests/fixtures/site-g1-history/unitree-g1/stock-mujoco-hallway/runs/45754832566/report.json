    "description": {
      "source": {
        "path": "specs/scenarios/walk-hallway/description.json",
        "sha256": "788bcd6345dad4d262ea14fc346d8883933b790f4991302f01d6eee84f52ff21",
        "commit": "57317e617014a6df97bb7fba9d92a890af8d42e5"
      },
      "$comment": "Human-readable text for walk-hallway 0.1.0 on hallway-open 0.1.0 (specs #30). Text only; README.md stays normative.",
      "format": "livingproof-scenario-description/0.1",
      "scenario": {
        "id": "walk-hallway",
        "revision": "0.1.0"
      },
      "mission": {
        "title": "Walk the hallway",
        "description": "The robot starts at the hallway entrance and is commanded to walk straight ahead at 0.5 m/s. It must reach the exit, 5.5 m along the route, within 27 s, staying upright, never touching either wall, and staying within its lateral limit of the centreline.",
        "success_criteria": [
          {
            "evaluator": "hallway-exit-reached",
            "text": "Reaches the exit, 5.5 m along the route, within 27 s, crossing it inside the exit segment."
          },
          {
            "evaluator": "hallway-wall-contact",
            "text": "Never touches a side wall."
          },
          {
            "evaluator": "hallway-fall",
            "text": "Stays upright: the base never drops below the fall height."
          },
          {
            "evaluator": "hallway-lateral-limit",
            "text": "Stays within its lateral limit of the hallway centreline."
          }
        ],
        "grading": "One run is one or more identical trials at the exact nominal pose. The default is 1. A grading policy turns completed trial outcomes into the run grade. ERROR is a test-system status reported on the job and on the trial. It is never a robot grade and is never counted as a robot fail. If no trial completes because of test-system errors, the run is not evaluated and the grade is INSUFFICIENT_EVIDENCE. A failed trial is not retried.",
        "time_limit_explained": "27 s is twice the time the route takes at the commanded speed, plus 5 s (2 \u00d7 5.5 m \u00f7 0.5 m/s + 5 s)."
      },
      "world": {
        "id": "hallway-open",
        "content_version": "0.1.0",
        "title": "Open hallway",
        "description": "A straight, empty hallway 1.50 m wide between the walls and 6.00 m long, with 2.50 m-high walls. Nothing else is in it: the test is whether the robot can hold a straight line.",
        "dimensions": {
          "clear_width": {
            "value": 1.5,
            "unit": "m"
          },
          "length": {
            "value": 6,
            "unit": "m"
          },
          "wall_height": {
            "value": 2.5,
            "unit": "m"
          },
          "wall_thickness": {
            "value": 0.15,
            "unit": "m"
          }
        }
      },
      "parameters": {
        "route_length": {
          "value": 5.5,
          "unit": "m"
        },
        "command_speed": {
          "value": 0.5,
          "unit": "m/s"
        },
        "time_limit": {
          "value": 27,
          "unit": "s",
          "formula": "2 \u00d7 route_length \u00f7 command_speed + 5 s"
        },
        "trials": {
          "count": 1,
          "retries": false
        },
        "wall_clearance": {
          "humanoid": {
            "value": 0.05,
            "unit": "m"
          },
          "quadruped": {
            "value": 0.1,
            "unit": "m"
          }
        }
      },
      "limits": {
        "lateral_limit": {
          "unit": "m",
          "formula": "clear_width \u00f7 2 \u2212 robot_width \u00f7 2",
          "inputs": {
            "clear_width": "world clear width",
            "robot_width": "robot profile dimensions.width"
          },
          "text": "How far the robot's centre may drift from the centreline before its side would reach a wall: half the clear width minus half the robot's width.",
          "sentence": "{robot} may drift up to {value} m either side of the centreline: half the {clear_width} m hallway, minus half its {robot_width} m width."
        },
        "exit_segment": {
          "unit": "m",
          "formula": "|y| \u2264 clear_width \u00f7 2",
          "inputs": {
            "clear_width": "world clear width"
          },
          "text": "The exit counts only when the robot's base crosses it between the walls, within half the clear width of the centreline."
        },
        "fall_height": {
          "unit": "m",
          "formula": "locomotion.fall_base_height",
          "inputs": {
            "fall_base_height": "configuration profile locomotion.fall_base_height"
          },
          "text": "The lowest base height that still counts as upright, declared by the selected configuration."
        },
        "fits_width": {
          "unit": "m",
          "formula": "robot_width + 2 \u00d7 wall_clearance \u2264 clear_width",
          "inputs": {
            "robot_width": "robot profile dimensions.width",
            "wall_clearance": "parameters.wall_clearance for the robot class",
            "clear_width": "world clear width"
          },
          "text": "Checked before any trial: the robot fits when its width plus the wall clearance on each side (0.05 m for a humanoid, 0.10 m for a quadruped) is at most the clear width. A robot that does not fit is UNSUPPORTED, not run.",
          "sentence": "{robot} fits: {robot_width} m + 2 \u00d7 {wall_clearance} m \u2264 {clear_width} m."
        }
      }
    }
  },
